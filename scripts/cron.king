# Linkr(king) 정기 작업 (서버 시간대 UTC 기준, 한국 시간 = UTC + 9)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 매일 03:40 (한국) DB 자동 백업 → /var/www/backups/king_auto (7일 지난 백업은 자동 삭제)
# 체험 계정 초기화(04:00)보다 먼저 돌도록 시간을 맞춤. 스크립트 원본: scripts/backup-db.sh
40 18 * * * root /usr/local/sbin/king-backup >> /var/log/king/backup.log 2>&1

# 매일 04:00 (한국) 체험 계정을 샘플 데이터가 들어있는 처음 상태로 초기화
0 19 * * * www-data cd /var/www/king && php spark demo:reset >> writable/logs/cron-demo-reset.log 2>&1

# 매시간 5분: 이용 기간이 끝난 유료 회원을 무료로 전환 (한동안 접속 안 한 회원까지 처리)
5 * * * * www-data cd /var/www/king && php spark plan:apply-downgrades >> writable/logs/cron-plan-downgrades.log 2>&1
